#!/bin/sh
# Before the files go: stop the service so nothing runs from files that are about to change. On an upgrade the postinst starts it again.
set -e

case "$1" in
    remove|upgrade|deconfigure)
        if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet falcon-engine; then
            systemctl stop falcon-engine
        fi
        ;;
esac

exit 0
