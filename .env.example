# `python -m engine setup` writes .env from this file (git-ignored) and sets the rest up -- see engine/setup.py.
# The Engine, the tests and the scripts load .env themselves (common/dotenv.py); nothing is set in the shell.
# A variable already set in the real environment wins over .env.
FALCON_ENGINE_HOST=0.0.0.0
FALCON_ENGINE_PORT=7400

# Local PostgreSQL install (no Docker). Create the role/database once:
#   psql -U postgres -c "CREATE ROLE falcon LOGIN PASSWORD 'falcon';"
#   psql -U postgres -c "CREATE DATABASE falcon OWNER falcon;"
#   psql -U postgres -c "CREATE DATABASE falcon_test OWNER falcon;"
FALCON_DATABASE_URL=postgresql://falcon:falcon@localhost:5432/falcon

# TLS (implementation-spec.md §8.3). Missing/invalid cert stops the Engine starting.
#   python -m engine gencert <names the clients will use, comma-separated DNS/IP> data
FALCON_TLS_CERT=data/engine.crt
FALCON_TLS_KEY=data/engine.key

# Master secret (spec §8.2): created on first start, never transmitted; every client key derives
# from it -- back it up, and keep it out of git (data/ is ignored).
# FALCON_SECRET_PATH=data/master.secret

# Development-only flags. Off by default; logged loudly on startup when on.
# FALCON_DEV_BYPASS_AUTH=1     # skip the auth handshake entirely (spec §8.1)
# FALCON_DEV_PLAINTEXT=1       # run without TLS (never a silent fallback — explicit and loud)

# Tests: a DEDICATED database -- the suite drops and recreates its schema. Never the dev DB (the suite refuses it).
FALCON_TEST_DATABASE_URL=postgresql://falcon:falcon@localhost:5432/falcon_test

# Local LLM for Task's natural-language verification. Local only, never an external API.
# Default: in-process llama.cpp with a GGUF under models/ (git-ignored).
# FALCON_LLM_BACKEND=llamacpp
# FALCON_LLM_MODEL_PATH=models/Qwen3-1.7B-Q8_0.gguf
#   The 0.6B is ~3x faster per call but markedly less accurate on the Task decision graph
#   (held-out benchmark 24/32 vs 29/32): FALCON_LLM_MODEL_PATH=models/Qwen3-0.6B-Q8_0.gguf
# Sidecar alternatives (a separate local process):
#   python -m llama_cpp.server --model models/Qwen3-1.7B-Q8_0.gguf --port 8008
#   FALCON_LLM_BACKEND=openai  FALCON_LLM_ENDPOINT=http://127.0.0.1:8008
#   FALCON_LLM_BACKEND=ollama  FALCON_LLM_ENDPOINT=http://127.0.0.1:11434  FALCON_LLM_MODEL=qwen3:1.7b
